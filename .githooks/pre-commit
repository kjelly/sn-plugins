#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root/packages/markdown-notes-plus"

# Commits must validate the exact production artifact, under the Standard
# Notes sandbox/CSP contract, in both supported browsers. Mise supplies the
# pinned Node, Deno, and Python runtimes declared at the repository root.
mise run test:e2e:release
